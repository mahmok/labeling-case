{
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "hono-openapi": "^1.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "name": "backend",
  "private": true,
  "scripts": {
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/db/drizzle.config.ts",
    "db:migrate:runtime": "bun run migrate.ts",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "dev:api": "bun run --watch index.api.ts",
    "dev:worker": "bun run --watch index.worker.ts",
    "start:api": "bun run index.api.ts",
    "start:worker": "bun run index.worker.ts",
    "test": "bun test --isolate",
    "test:e2e": "bun test --isolate tests/e2e",
    "test:integration": "bun test --isolate tests/integration",
    "test:unit": "bun test src",
    "test:watch": "bun test --watch"
  },
  "type": "module"
}
